# Copy to .env.local and fill in. Never commit real values.
# Local values come from `pnpm exec supabase status` after `pnpm exec supabase start`.
# Deployed values live in Vercel and Supabase environment settings only.

# Public (sent to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Street maps on /search (Maps JavaScript API). A Map ID enables the newer markers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Server only
# App queries. Deployed: Supabase transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Migrations (drizzle-kit). Deployed: a direct or session-pooler connection (port 5432).
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Notifications & background jobs
CRON_SECRET=bookanto-dev-cron-secret
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=BooKanto
SUPABASE_SMS_HOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL="BooKanto <notifications@bookanto.ph>"
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VIBER_AUTH_TOKEN=
VIBER_SENDER_NAME=BooKanto
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@bookanto.ph"

# Deposits and online payment (PayMongo). Leave empty to keep online payment off.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Google OAuth (direct callback at /auth/callback so Google displays "continue to BooKanto"
# instead of "<project-ref>.supabase.co"). Also used by supabase/config.toml locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

