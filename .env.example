# Copy to .env.local and fill in. Never commit real values.
# Local values come from `pnpm exec supabase status` after `pnpm exec supabase start`.
# Deployed values live in Vercel and Supabase environment settings only.

# Public (sent to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: older copy of VAPID_PUBLIC_KEY. The server passes VAPID_PUBLIC_KEY to the page.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Street maps on /search (Maps JavaScript API). A Map ID enables the newer markers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Server only
# App queries. Deployed: Supabase transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Migrations (drizzle-kit). Deployed: a direct or session-pooler connection (port 5432).
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Notifications & background jobs
CRON_SECRET=bookanto-dev-cron-secret
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=BooKanto
# Server-only Supabase secret key for private document storage. Locally:
# `pnpm exec supabase status -o env` prints it as SECRET_KEY.
SUPABASE_SECRET_KEY=
SUPABASE_SMS_HOOK_SECRET=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VIBER_AUTH_TOKEN=
VIBER_SENDER_NAME=BooKanto
# Web push. Without both keys the "Turn on" button explains push isn't available.
# Generate with `npx web-push generate-vapid-keys` (raw base64url; PEM also works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@bookanto.ph"

# Email: booking confirmations, reminders and shop alerts (lib/notify.ts).
# EMAIL_PROVIDER is smtp, resend or log. Empty picks SMTP when SMTP_HOST is set,
# then Resend when RESEND_API_KEY is set, else log (nothing is sent).
EMAIL_PROVIDER=smtp
EMAIL_FROM="BooKanto <notifications@bookanto.ph>"
# Local: Inbucket from docker-compose.yml takes the mail (no login needed) and shows it at
# http://localhost:54324. Deployed: your provider's SMTP server, for example
# smtp-relay.brevo.com or smtp.gmail.com on port 587 with SMTP_USER and SMTP_PASSWORD
# (Gmail needs an app password). SMTP_SECURE defaults to true on port 465, false otherwise;
# on 587 it must stay false (Gmail: smtp.gmail.com, 587, SMTP_SECURE=false).
# EMAIL_FROM must be an address the provider lets you send from.
SMTP_HOST=127.0.0.1
SMTP_PORT=2500
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Resend's HTTP API instead of SMTP (EMAIL_PROVIDER=resend).
RESEND_API_KEY=

# Deposits and online payment (PayMongo). Leave empty to keep online payment off.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Google OAuth (direct callback at /auth/callback so Google displays "continue to BooKanto"
# instead of "<project-ref>.supabase.co"). Also used by supabase/config.toml locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

