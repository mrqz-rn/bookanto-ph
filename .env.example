# Copy to .env.local and fill in. Never commit real values.
# Local values come from `pnpm exec supabase status` after `pnpm exec supabase start`.
# Deployed values live in Vercel and Supabase environment settings only.

# Public (sent to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only
# App queries. Deployed: Supabase transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Migrations (drizzle-kit). Deployed: a direct or session-pooler connection (port 5432).
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
